{
  "name": "react-testing-demo",
  "version": "1.0.0",
  "description": "A tutorial of testing React components",
  "main": "app/main.jsx",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint 'app/**/*.@(js|jsx)'",
    "test": "mocha --compilers js:babel-core/register --require ./test/setup.js",
    "build": "webpack",
    "start": "webpack-dev-server --devtool eval --progress --hot --colors --content-base app",
    "deploy": "NODE_ENV=production webpack -p --config webpack.production.config.js",
    "validate": "npm ls"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/eslint-parser": "^7.26.5",
    "@babel/plugin-transform-runtime": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel-loader": "^9.2.1",
    "chai": "^4.2.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "enzyme": "^3.9.0",
    "eslint": "^9.18.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-react": "^7.37.3",
    "jsdom": "^26.0.0",
    "jsx-test": "^2.1.0",
    "mocha": "^11.0.1",
    "object-assign": "^4.1.1",
    "open-browser-webpack-plugin": "0.0.5",
    "precommit-hook": "^3.0.0",
    "react-addons-test-utils": "^15.6.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-dev-server": "^5.2.3"
  },
  "keywords": [
    "react",
    "test",
    "enzyme"
  ],
  "author": "Ruan Yifeng",
  "license": "MIT",
  "pre-commit": [
    "lint"
  ]
}
